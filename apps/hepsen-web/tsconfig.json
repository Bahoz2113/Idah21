{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] },
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["next-env.d.ts", "src", "tests", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "src/app/sw.ts"]
}
