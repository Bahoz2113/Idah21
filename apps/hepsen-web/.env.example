# HEP-SEN Batman — Başkanlık İletişim OS — apps/hepsen-web
# Bu dosyayı .env.local olarak kopyala ve gerçek değerlerle doldur.
# .env.local ASLA commit edilmez (repo kökü .gitignore içinde .env* zaten hariç).

NEXT_PUBLIC_APP_URL=http://localhost:3010

# Supabase (proje: hepsen-batman, eu-central-1 — CEZERİ'nin projesinden AYRI)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# X (Twitter) OAuth 2.0 Authorization Code + PKCE — bkz. docs/adr/0002
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3010/api/auth/x/callback

# Access/refresh token şifreleme (AES-256-GCM) — 32 byte, base64. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Apify (bkz. docs/adr/0003 — kod hazır, gerçek token gelene kadar sessizce atlanır)
APIFY_API_TOKEN=
APIFY_X_ACTOR_ID=

# LLM sağlayıcı (bkz. docs/adr/0004, docs/adr/0005 — bu turda yalnızca Anthropic uygulandı)
LLM_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Gözlemlenebilirlik
SENTRY_DSN=

# Arka plan işleri (Vercel Cron -> /api/internal/jobs/*, bkz. vercel.json).
# Vercel, bu env değişkeni proje ayarlarında tanımlıysa cron isteğine otomatik
# "Authorization: Bearer <CRON_SECRET>" ekler. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=

# Bütçe koruma motoru (bkz. packages/core/src/budget/guard.ts)
MONTHLY_BUDGET_USD=20

APP_TIMEZONE=Europe/Istanbul
