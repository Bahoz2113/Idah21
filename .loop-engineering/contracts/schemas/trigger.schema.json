{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trigger",
  "type": "object",
  "required": ["trigger_id","type","action"],
  "properties": {
    "trigger_id": {"type": "string"},
    "type": {"enum": ["manual","scheduled","event","metric","composite"]},
    "schedule": {"type": "string"},
    "event": {"type": "string"},
    "when": {"type": "object"},
    "action": {"type": "object"},
    "cooldown_minutes": {"type": "number"},
    "idempotency_key": {"type": "string"},
    "enabled": {"type": "boolean"}
  }
}
