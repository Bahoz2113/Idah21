{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Score",
  "type": "object",
  "required": ["timestamp","total"],
  "properties": {
    "timestamp": {"type": "string"},
    "iteration": {"type": ["integer","null"]},
    "total": {"type": "number", "minimum": 0, "maximum": 100},
    "pass_rate": {"type": "number"},
    "breakdown": {"type": "object"}
  }
}
