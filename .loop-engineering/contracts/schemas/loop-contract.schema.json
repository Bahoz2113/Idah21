{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoopContract",
  "type": "object",
  "required": ["loop_id","loop_name","version","objective","acceptance_criteria","target_score","max_iterations","risk_level","stop_conditions"],
  "properties": {
    "loop_id": {"type": "string"},
    "loop_name": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string"},
    "created_by": {"type": "string"},
    "objective": {"type": "string", "minLength": 5},
    "business_goal": {"type": "string"},
    "template": {"type": "string"},
    "in_scope": {"type": "array", "items": {"type": "string"}},
    "out_of_scope": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification_methods": {"type": "array", "items": {"type": "string"}},
    "quality_threshold": {"type": "number", "minimum": 0, "maximum": 100},
    "baseline_score": {"type": "number"},
    "target_score": {"type": "number", "minimum": 0, "maximum": 100},
    "minimum_improvement": {"type": "number"},
    "max_iterations": {"type": "integer", "minimum": 1},
    "max_retries_per_step": {"type": "integer"},
    "risk_level": {"enum": ["low","medium","high","critical"]},
    "required_approvals": {"type": "array"},
    "rollback_policy": {"type": "string"},
    "stop_conditions": {"type": "array", "minItems": 1},
    "allowed_tools": {"type": "array"},
    "forbidden_actions": {"type": "array"},
    "data_classification": {"type": "string"}
  }
}
